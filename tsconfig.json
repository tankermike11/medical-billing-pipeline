{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["shared/**/*", "phase1/**/*", "phase2/**/*", "phase3/**/*"],
  "exclude": ["node_modules", "dist"]
}
